# ==========================================
# TalentTrack Environment Configuration Template
# ==========================================

# ASP.NET Core Environment (Development / Production)
ASPNETCORE_ENVIRONMENT=Development

# Application Port
PORT=5029

# Auto-apply EF Core database migrations on startup (true / false)
AUTO_MIGRATE=false

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=Host=your-db-host;Port=5432;Database=postgres;Username=postgres.yourusername;Password=yourpassword;SSL Mode=Prefer;

# Email / SMTP Configuration
EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SenderName=TalentTrack Team
EmailSettings__SenderEmail=your-email@gmail.com
EmailSettings__Username=your-email@gmail.com
EmailSettings__Password=your-app-password
EmailSettings__EnableSsl=true
